{
  "name": "eddy-editor",
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "description": "A lightweight Vue 3 WYSIWYG text editor",
  "license": "MIT",
  "author": "Thijs Wijnmaalen",
  "repository": {
    "type": "git",
    "url": "https://github.com/thijsw/eddy-editor.git"
  },
  "homepage": "https://github.com/thijsw/eddy-editor#readme",
  "bugs": "https://github.com/thijsw/eddy-editor/issues",
  "keywords": [
    "vue",
    "editor",
    "wysiwyg",
    "rich-text",
    "contenteditable",
    "vue3",
    "ast"
  ],
  "files": [
    "dist",
    "style.css"
  ],
  "main": "./dist/eddy-editor.js",
  "module": "./dist/eddy-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/eddy-editor.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./style.css"
  },
  "scripts": {
    "dev": "vite --config vite.playground.ts",
    "dev:lib": "vite build --watch",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "playwright test",
    "test:unit": "vitest run",
    "prepare": "git config core.hooksPath .githooks"
  },
  "peerDependencies": {
    "vue": "^3.0.0",
    "@lucide/vue": "^1.0.0"
  },
  "devDependencies": {
    "@lucide/vue": "^1.8.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.1.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.10"
  }
}
