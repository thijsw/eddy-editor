{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist",
    "jsx": "react-jsx",
    "paths": {
      "eddy-editor": ["./src/index.ts"],
      "eddy-editor/vue": ["./src/vue/index.ts"],
      "eddy-editor/react": ["./src/react/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.vue",
    "playground/**/*.ts",
    "playground/**/*.vue",
    "playground-react/**/*.ts",
    "playground-react/**/*.tsx"
  ]
}
